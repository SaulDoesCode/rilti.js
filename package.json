{
  "name": "rilti",
  "version": "0.11.0",
  "description": "small opinionated future forward frontend framework",
  "main": "./dist/rilti.js",
  "module": "./dist/rilti.mjs",
  "unpkg": "./dist/rilti.min.js",
  "jsdelivr": "./dist/rilti.min.js",
  "exports": {
    ".": {
      "import": "./dist/rilti.mjs",
      "default": "./dist/rilti.js"
    },
    "./min": "./dist/rilti.min.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "plugins"
  ],
  "sideEffects": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sauldoescode/rilti.js.git"
  },
  "keywords": [
    "view",
    "library",
    "front-end",
    "frontend",
    "toolkit",
    "components",
    "framework",
    "proxy",
    "dom"
  ],
  "author": "Saul van der Walt",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sauldoescode/rilti.js/issues"
  },
  "homepage": "https://github.com/sauldoescode/rilti.js#readme",
  "scripts": {
    "build": "rollup -c",
    "dev": "node scripts/dev.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "eslint": "^9.39.5",
    "jsdom": "^29.1.1",
    "neostandard": "^0.14.0",
    "rollup": "^4.64.5",
    "vitest": "^5.0.3"
  }
}
